# GA4 measurement ID (G-XXXXXXXXXX). Empty means no analytics: no script, no banner, no cookie settings link,
# and no Google hosts in the CSP. Inlined at build time, so set it before `npm run build`.
NEXT_PUBLIC_GA_ID=

# Microsoft Clarity project id. Loaded only after the visitor accepts analytics, behind the same banner as GA4.
# Empty means no Clarity tag and no Clarity or Bing hosts in the CSP. Inlined at build time, like the GA id.
NEXT_PUBLIC_CLARITY_ID=

# Where company requests are stored. Without it the request form returns 503.
REQUESTS_DB_PATH=

# IndexNow key (8 to 128 characters of a-z, A-Z, 0-9 and dash). The site serves it at /<key>.txt, read at
# request time, and scripts/indexnow.mjs submits with it. Unset means /<key>.txt is 404 and nothing is submitted.
INDEXNOW_KEY=

# Host that scripts/indexnow.mjs submits for, for example pilot.scndorder.com. --host overrides it.
INDEXNOW_HOST=
